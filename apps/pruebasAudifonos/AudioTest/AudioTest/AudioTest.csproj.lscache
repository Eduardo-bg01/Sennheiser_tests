/filealign:512
/optimize-
/out:obj\Debug\net8.0-windows\AudioTest.dll
/refout:obj\Debug\net8.0-windows\refint\AudioTest.dll
/target:winexe
/warnaserror-
/utf8output
/deterministic+
/langversion:12.0
/warnaserror+:NU1605,SYSLIB0011

